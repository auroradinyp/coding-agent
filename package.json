{
  "name": "coding-agent",
  "version": "0.1.0",
  "description": "Minimal coding agent (bash/read/write/edit) built with Node.js + OpenTUI",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "ca": "bin/ca.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "src"
  ],
  "scripts": {
    "start": "node scripts/run.mjs src/index.js",
    "chat": "node scripts/run.mjs src/cli.js",
    "inspect": "node scripts/run.mjs --network --log-api src/index.js",
    "inspect:chat": "node scripts/run.mjs --network --log-api src/cli.js",
    "viewer": "node scripts/serve-debug-ui.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=26.4.0"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11"
  },
  "devDependencies": {
    "node-network-devtools": "^1.0.30"
  }
}
